# Cloudflare Tunnel Configuration
# Domain: helpdeskit.biz.id
#
# FILE INI ADALAH TEMPLATE.
# Setelah menjalankan setup-tunnel.sh, file ini akan digenerate otomatis
# di ~/.cloudflared/config.yml dengan tunnel UUID yang benar.
#
# Jika ingin manual, ikuti langkah di README-cloudflare.md

tunnel: YOUR-TUNNEL-UUID-HERE
credentials-file: /home/zabbix/.cloudflared/YOUR-TUNNEL-UUID-HERE.json

ingress:
  # Route utama ke aplikasi Helpdesk (FastAPI di port 8000)
  - hostname: helpdeskit.biz.id
    service: http://localhost:8000

  # Route www
  - hostname: www.helpdeskit.biz.id
    service: http://localhost:8000

  # API Helpdesk (Flask di port 5005)
  - hostname: api.helpdeskit.biz.id
    service: http://localhost:5005

  # Catch-all — kirim 404 untuk semua request lain
  - service: http_status:404

# Cloudflare Tunnel settings
# https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/
