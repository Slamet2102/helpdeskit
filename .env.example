# Copy this file to .env and fill in the real values.
# Jangan commit file .env yang berisi credential asli.

DATABASE_URL=sqlite:///./helpdesk.db
UPLOAD_DIR=./uploads

# WAHA
WAHA_API_URL=http://localhost:3000/api
WAHA_SESSION_NAME=default
WAHA_GROUP_ID=
WAHA_API_KEY=
WAHA_API_AUTH_HEADER_NAME=X-Api-Key
WAHA_API_KEY_IN=header
WAHA_API_KEY_PARAM=token
WAHA_IT_NUMBER=6281234567890

# Aplikasi
BASE_URL=http://localhost:8000
SECRET_KEY=change-this-secret-key-in-production
